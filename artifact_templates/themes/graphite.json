{
  "name": "graphite",
  "description": "Near-black with minimal blue-gray accent. Maximum austerity. For technical and diagnostic artifacts.",
  "variables": {
    "--bg-primary":    "#0A0A0B",
    "--bg-secondary":  "#111113",
    "--bg-card":       "rgba(255,255,255,0.025)",
    "--bg-card-hover": "rgba(255,255,255,0.05)",
    "--text-primary":  "#D4D8DE",
    "--text-secondary":"#7B8794",
    "--text-muted":    "#404850",
    "--accent":        "#64748B",
    "--accent-light":  "#94A3B8",
    "--accent-glow":   "rgba(100,116,139,0.12)",
    "--success":       "#10B981",
    "--warning":       "#F59E0B",
    "--critical":      "#EF4444",
    "--inactive":      "#4B5563",
    "--border":        "rgba(255,255,255,0.05)",
    "--border-accent": "rgba(100,116,139,0.25)",
    "--font-display":  "'Cormorant Garamond', Georgia, serif",
    "--font-body":     "'Outfit', system-ui, sans-serif",
    "--font-mono":     "'JetBrains Mono', 'Fira Code', monospace",
    "--radius":        "4px",
    "--shadow-card":   "0 1px 4px rgba(0,0,0,0.4)",
    "--shadow-hover":  "0 4px 16px rgba(0,0,0,0.5)",
    "--transition-fast":   "0.12s ease",
    "--transition-normal": "0.25s ease",
    "--transition-slow":   "0.4s ease"
  }
}
