__pycache__/
instrument/data/*.faiss
instrument/data/*.npy
instrument/data/v1/*.npy
instrument/data/v2/*.npy
instrument/step13_stderr.log
instrument/docx_structure_scan*.txt

# Environment files — contain local overrides, not for version control
.env

# Runtime data — generated at operation time, never committed
memory/
sleep_reports/
procedural_memory/
operator_profile.json
operator_profile_approved.json
operator_profile_versions/
action_boundary_config.json
# ...but the PLUGIN copy is a shipped default (tier policies + _notes), not
# operator state, and it is byte-identical to what runs on VekV2. The bare
# pattern above was written for the root-level runtime copy and silently caught
# this one too, so `git archive` omitted it and a clone-and-install produced a
# container without it. Found by the step-3 parity gate, 2026-08-19.
!plugins/_exocortex/config/action_boundary_config.json
agents/
state/

# Inference — llama.cpp source clones and compiled builds (large, not committed)
inference/llama-cpp-*/
inference/buun-llama-cpp/
inference/lucebox-dflash/
inference/turbo3-cuda/
inference/build_log.txt
inference/mtp_server.log
inference/compile_*.bat
inference/compile.bat

# Attention Router runtime log (BP-01 cadence)
monitor/attention_router.log

# BP-02 harness runtime results
harness/results/

# Local backups and Windows shortcuts — never artifacts, always machine-local
*.bak-*
*.bak
*.lnk
