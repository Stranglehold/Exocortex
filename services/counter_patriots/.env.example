# Counter-Patriots environment configuration
# Copy to .env and fill in production values before deploying.

# Database password (change from default before production use)
CP_DB_PASSWORD=cp_dev_password

# Analyst authentication token (Festinger Boundary enforcement)
# Required to access /api/contradictions
# Change this to a strong random value in production
CP_ANALYST_TOKEN=dev_analyst_token

# LLM endpoint (LM Studio compatible)
# Points to host machine from Docker by default
CP_LLM_URL=http://host.docker.internal:1234/v1
CP_LLM_MODEL=qwen2.5-14b-instruct

# Embedding model (sentence-transformers)
CP_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion interval in minutes
CP_INGEST_INTERVAL_MINUTES=30

# Deduplication thresholds
# Claims with cosine >= this are considered duplicates (skip)
CP_DEDUP_THRESHOLD=0.95
# Claims with cosine >= this are compared for contradictions
CP_CONTRADICTION_SIMILARITY=0.72
# Elements with cosine >= this are treated as the same element (silence detection)
CP_ELEMENT_DEDUP_THRESHOLD=0.82

# Activation detection
# Minimum distinct clusters for an activation spike
CP_ACTIVATION_MIN_CLUSTER_SPREAD=3
# Time window in minutes for spike detection
CP_ACTIVATION_WINDOW_MINUTES=180
