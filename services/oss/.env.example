# OSS (Office of Strategic Services) environment configuration
# Copy to .env and fill in production values before deploying.

# Database passwords
# OSS_DB_PASSWORD: admin role (oss_admin) — used only for migrations and schema management
# OSS_APP_DB_PASSWORD: application role (oss_app) — used by the running service
#   oss_app has REVOKE UPDATE/DELETE on audit_log (append-only enforcement)
#   Run ./install.sh --migrate to create the oss_app role before first launch
OSS_DB_PASSWORD=oss_admin_dev_password
OSS_APP_DB_PASSWORD=oss_app_dev_password

# Claim promotion confidence threshold (0.0-1.0)
OSS_PROMOTION_THRESHOLD=0.75

# Analyst authentication token (Festinger Boundary enforcement)
# Required to access /api/contradictions
# Change this to a strong random value in production
OSS_ANALYST_TOKEN=dev_analyst_token

# LLM endpoint (LM Studio compatible)
# Points to host machine from Docker by default
OSS_LLM_URL=http://host.docker.internal:1234/v1
OSS_LLM_MODEL=qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q4_k_m

# Embedding model (sentence-transformers)
OSS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion interval in minutes
OSS_INGEST_INTERVAL_MINUTES=30

# Deduplication thresholds
# Claims with cosine >= this are considered duplicates (skip)
OSS_DEDUP_THRESHOLD=0.95
# Claims with cosine >= this are compared for contradictions
OSS_CONTRADICTION_SIMILARITY=0.72
# Elements with cosine >= this are treated as the same element (silence detection)
OSS_ELEMENT_DEDUP_THRESHOLD=0.82

# Activation detection
# Minimum distinct clusters for an activation spike
OSS_ACTIVATION_MIN_CLUSTER_SPREAD=3
# Time window in minutes for spike detection
OSS_ACTIVATION_WINDOW_MINUTES=180
